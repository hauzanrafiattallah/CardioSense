# Copy this file to .env.local, then replace the example values below.

# Server-only key for /api/chat. Never expose this as NEXT_PUBLIC_*.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=your_groq_model_here

# Base URL for the screening API. The app will POST to /predict automatically.
NEXT_PUBLIC_SCREENING_API_URL=https://your-screening-api.example.com
